# CRM360 Frontend Environment Variables Template
# Copy this file to .env and configure your values.

# Backend API Base URL (Use relative '/api' with Vite proxy for seamless local & port-forwarded access)
VITE_API_URL=/api

# Google Identity Services (GIS) Web OAuth Client ID
# Generated in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Format: XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
