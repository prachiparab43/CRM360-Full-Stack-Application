# CRM360 Backend Environment Variables Template
# Copy this file to .env and configure your values.

PROJECT_NAME=CRM360
DATABASE_URL=mssql+pyodbc://username:password@SERVERNAME/CRM360?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
SECRET_KEY=your-secure-random-secret-key-at-least-32-chars
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Client ID for server-side token validation
# Generated in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Must match the Client ID used on the frontend
GOOGLE_CLIENT_ID=
